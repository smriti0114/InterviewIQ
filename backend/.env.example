# ==============================================================================
# InterviewIQ - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: "gemini", "openai", "groq", "mock"
LLM_PROVIDER=gemini

# Your API Key (Get Gemini key at https://aistudio.google.com/ or OpenAI key at https://platform.openai.com/)
LLM_API_KEY=

# Optional model override (Default for Gemini: gemini-2.5-flash; for OpenAI: gpt-4o-mini)
LLM_MODEL=gemini-2.5-flash

# Optional base URL override (Useful for Groq, DeepSeek, LocalAI, or Ollama)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Database Configuration (SQLite default for 8GB RAM laptops, zero daemon overhead)
DATABASE_URL=sqlite:///./interviewiq.db

# JWT Authentication Secrets
JWT_SECRET_KEY=change_this_to_a_random_32_byte_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate Limiting (Generations per user per minute)
RATE_LIMIT_GENERATE_PER_MINUTE=15

# CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
